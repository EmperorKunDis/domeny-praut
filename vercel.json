{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node", "config": { "includeFiles": "assets/fonts/**" } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/availability", "dest": "/api/availability.js" },
    { "src": "/api/order", "dest": "/api/order.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.+)", "dest": "/public/$1" }
  ]
}
